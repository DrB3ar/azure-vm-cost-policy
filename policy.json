{
  "properties": {
    "displayName": "Azure VM Cost Control - Allowed SKUs",
    "policyType": "Custom",
    "mode": "All",
    "description": "Restricts Azure virtual machines to approved VM SKUs to help control compute costs.",
    "metadata": {
      "category": "Cost Management"
    },
    "parameters": {
      "allowedVmSkus": {
        "type": "Array",
        "metadata": {
          "displayName": "Allowed VM SKUs",
          "description": "List of approved virtual machine SKUs."
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Compute/virtualMachines"
          },
          {
            "field": "Microsoft.Compute/virtualMachines/sku.name",
            "notIn": "[parameters('allowedVmSkus')]"
          }
        ]
      },
      "then": {
        "effect": "Deny"
      }
    }
  }
}